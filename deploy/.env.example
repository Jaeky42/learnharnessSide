# Copy to .env and fill in.

# The address you open LearnHarness at. Its DNS A record must point at this server.
LH_DOMAIN=learn.example.com

# Which image to follow: "dev" (the cloud sync feature branch, while testing)
# or "latest" (releases from the side-tutor branch).
LH_CHANNEL=dev

# Your time zone, e.g. Europe/London or America/New_York. Used for log times.
# The nightly update runs at 4 am in the server's system time zone
# (set it with: sudo timedatectl set-timezone <zone>).
TZ=UTC
