# Copy to .env and fill in.

# The address you open LearnHarness at. Its DNS A record must point at this server.
LH_DOMAIN=learn.example.com

# Which image to follow: "dev" (the cloud sync feature branch, while testing)
# or "latest" (releases from the side-tutor branch).
LH_CHANNEL=dev

# Your time zone, e.g. Europe/London or America/New_York. Used for log times.
# The nightly update runs at 4 am in the server's system time zone
# (set it with: sudo timedatectl set-timezone <zone>).
TZ=UTC

# The most accounts this server holds, the owner's included (several people,
# one address). Paused accounts count; removed ones don't. To change it, edit
# this line and run ./update.sh.
LH_MAX_ACCOUNTS=4

# Docker's socket on this host, only if it isn't /var/run/docker.sock
# (make-secrets.sh and the maker's mount both use it):
# LH_DOCKER_SOCKET=/var/run/docker.sock

# Not set here by hand: LH_GATE_SECRET, LH_MAKER_TOKEN, LH_RELAY_TOKEN and
# LH_DOCKER_GID are added to .env by ./make-secrets.sh (run it once; it never
# replaces a value that is already there).
